# plataformas externas. Em Docker, use o nome interno do serviço e a porta 8000
# (ex.: http://achievist-app-1:8000) com o override docker-compose.achievist.yml.
ACHIEVIST_NETWORK=achievist_default
ACHIEVIST_BASE_URL=
ACHIEVIST_USERNAME=
ACHIEVIST_PASSWORD=
