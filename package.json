{
  "name": "gameshelf",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm --parallel --filter @gameshelf/api --filter @gameshelf/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @gameshelf/api --filter @gameshelf/web test",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @gameshelf/database db:generate",
    "db:migrate": "pnpm --filter @gameshelf/database db:migrate"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "eslint": "^9.28.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.1",
    "@playwright/test": "^1.52.0",
    "vitest": "^3.2.4"
  }
}
